# TypeScript
*.tsbuildinfo
tsconfig.node.tsbuildinfo

# Cache and temp files
.cache
.temp
.tmp
.eslintcache
.stylelintcache

# Database
./db/*
apps/db/*
apps/tauri/db/*

# Rust/Cargo
target/
**/target/
**/*.rs.bk

# Tauri generated artefacts
#   - `apps/tauri/gen/schemas/` is regenerated on every build, never commit
#   - `apps/tauri/gen/.tauri/` is a transient build cache
#   - The Xcode project under `apps/tauri/gen/apple/` IS tracked, do not exclude
apps/tauri/gen/schemas/
apps/tauri/gen/.tauri/
apps/tauri/src-tauri/target/
*.tauri-build

# Native build outputs (never commit installer binaries)
*.app
*.dmg
*.AppImage
*.msi
*.exe

# Tool caches (Next / Turbo / Parcel)
.turbo/
.next/
.parcel-cache/

# Local AI model artefacts (Ollama / llama.cpp / similar)
*.gguf
*.bin
models/

# Generic tmp files
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/AI-POC-COPY
# AI tools
.codex/
.ralph-tui/
.kiro/
.conductor/

# Claude Code runtime artifacts (keep CLAUDE.md, skills/, agents/ tracked)
.claude/scheduled_tasks.lock
.claude/*.lock
# Local SQLite runtime DB directories — top-level + Tauri-side only.
# A bare unscoped `db/` rule was previously here, which silently
# gitignored crates/storage-sqlite/src/db/ (real source) and broke CI.
/db/
/apps/db/
/apps/tauri/db/
tasks
**/*.local.md
